# Render ignore file
# Files and directories to exclude from deployment

# Development files
.env.local
.env.development
.env.test
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
__tests__/
tests/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation (optional - can be included)
# *.md
# !README.md

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Build artifacts (will be regenerated)
.next/
out/
dist/
build/

# Cache
.cache/
.npm/
.yarn/

# Misc
*.tsbuildinfo
.eslintcache

