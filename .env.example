# === Frontend Environment Variables ===

# The base URL of your backend API (Django/DRF)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Secret key used by NextAuth.js
NEXTAUTH_SECRET=changeme123

# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000

# Optional: OAuth provider configs (if enabled later)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# File upload size limit (should match backend, in MB)
NEXT_PUBLIC_MAX_FILE_SIZE=20
