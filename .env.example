# === Frontend base configuration ===

# URL of the Next.js app in development
NEXTAUTH_URL=http://localhost:3000

# URL of your backend API (must include /api if your backend is at /api/)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Secret used by NextAuth to sign/encrypt tokens.
# For development you can use any random string, but generate a strong one for production:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-insecure-nextauth-secret-change-me

# === CORS / security related ===

# Comma-separated list of allowed origins for CORS (used by next.config.js and API proxy)
# For local dev:
ALLOWED_ORIGINS=http://localhost:3000

# Whether the /api/health endpoint should also check backend connectivity.
# In dev you can enable this if your backend is running and has /health/.
HEALTH_CHECK_BACKEND=false
# Optional: explicit URL for the backend health probe (only used when HEALTH_CHECK_BACKEND=true).
# Defaults to the origin of NEXT_PUBLIC_API_URL + /health/
# e.g. NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api → probes http://127.0.0.1:8000/health/
# Set this if your backend health endpoint is at a non-standard path.
# HEALTH_CHECK_BACKEND_URL=http://127.0.0.1:8000/health/

# Enable extra logging even outside development.
# In dev this doesn’t matter much because logging is already enabled when NODE_ENV=development.
ENABLE_LOGGING=false

# === Node environment (usually set automatically by Next/Vercel) ===
# For local dev, Next sets NODE_ENV=development. You normally don’t need to set this manually.
# NODE_ENV=development

# Optional
ALLOWED_ORIGINS=https://your-project-name.vercel.app
HEALTH_CHECK_BACKEND=false
ENABLE_LOGGING=false
NEXT_PUBLIC_MAX_FILE_SIZE=20
